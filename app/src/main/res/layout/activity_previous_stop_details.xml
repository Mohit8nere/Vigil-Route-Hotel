<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F6FAFF">

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- TOP BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:src="@drawable/baseline_arrow_back_ios_new_24"
                  android:scaleType="centerInside" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Stop Details"
                    android:textColor="#0D58B8"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="↗"
                    android:visibility="invisible"
                    android:textColor="#111827"
                    android:textSize="24sp" />

            </LinearLayout>

            <!-- CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvStopName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stop Name"
                    android:textColor="#111827"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text = "sadfhuasdfnhvuiashgfiuvsaldngiluvsdsdgvnszndbgkjswndfngkajsdnfgk;anf;gjklnsdkjlfgndfjkgnaklngdghygvkjlsdgvuisdhgbviudsfhbvqwdfgrswbrwshg"/>

                <TextView
                    android:id="@+id/tvRouteName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Route"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="skjdfgnkjbedsnkjbsdfnuhsdngnsdgsao;jgoaigi;angiajgtiadnmgdkfjgni"/>

                <TextView
                    android:id="@+id/tvDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Date Time"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOfficerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Officer"
                    android:textColor="#111827"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnOpenMap"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Open in Map"
                    android:background = "@drawable/bg_rounded_transparent"
                    android:textColor="#0D58B8"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- FACE IMAGE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Face Image"
                android:textColor="#0D58B8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgFace"
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginTop="12dp"
                android:background="#E5E7EB"
                android:elevation="3dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvEvidenceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Evidence Images"
                android:textColor="#0D58B8"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/evidenceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
            <!-- DETAILS -->
            <TextView
                android:id="@+id/tvReachedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Reached:"
                android:textColor="#374151"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvUploadTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Uploaded:"
                android:textColor="#374151"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvExitTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Exited:"
                android:textColor="#374151"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvLatLng"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Location:"
                android:textColor="#374151"
                android:textSize="15sp" />

        </LinearLayout>

    </ScrollView>

    <!-- FIXED PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>