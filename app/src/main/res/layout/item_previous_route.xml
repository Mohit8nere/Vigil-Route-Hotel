<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="#FFFFFF"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_rounded_transparent"
        android:gravity="center"
        android:text="📅"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRouteDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="19 May 2026"
            android:textColor="#0D58B8"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRouteName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:text="electronic complex patrol"
            android:textColor="#4B5563"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvStopCount"
        android:layout_width="82dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_rounded_transparent"
        android:gravity="center"
        android:text="20 Stops"
        android:textColor="#0D58B8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tvArrow"
        android:layout_width="32dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:src="@drawable/ic_down_arrow"
        android:textStyle="bold" />

</LinearLayout>